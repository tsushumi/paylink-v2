# ---- Server ----
PORT=3001
CLIENT_URL=http://localhost:5173
# PostgreSQL (local Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=paylink postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paylink"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development
APP_TIMEZONE=Africa/Nairobi

# ---- M-Pesa (Daraja) ----
# Leave blank (or MPESA_MOCK=true) to run in mock mode: no real STK Push is sent,
# and a fake callback fires automatically after MPESA_MOCK_CALLBACK_DELAY_MS.
MPESA_MOCK=true
MPESA_MOCK_AUTO_CALLBACK=true
MPESA_MOCK_CALLBACK_DELAY_MS=5000
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public URL Safaricom can reach (ngrok / Railway / Render), e.g. https://abc123.ngrok.app/api/mpesa/callback
MPESA_CALLBACK_URL=
# Optional shared secret appended as ?token=... to the callback URL
MPESA_CALLBACK_TOKEN=

# ---- Resend (email) ----
# Blank = emails are logged to the console and kept in the dev outbox instead of sent.
RESEND_API_KEY=
# onboarding@resend.dev can only deliver to your own Resend account email until you verify a domain.
FROM_EMAIL=PayLink <onboarding@resend.dev>

# ---- Africa's Talking (SMS) ----
# Blank = SMS is logged to the console and kept in the dev outbox instead of sent.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional alphanumeric sender id (must be approved by Africa's Talking; leave blank in sandbox)
AT_SENDER_ID=

# ---- WhatsApp Cloud API (stretch) ----
# Blank = messages are logged / kept in the dev outbox (mock mode).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=payment_confirmation
WHATSAPP_TEMPLATE_LANG=en

# ---- Daily summary email (stretch) ----
# true = send each merchant a summary at DAILY_SUMMARY_HOUR (Nairobi time, 0-23).
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=20
DASHBOARD_URL=http://localhost:5173
